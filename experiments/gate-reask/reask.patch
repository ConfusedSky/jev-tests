+/** A gate value within this of the threshold is asked AGAIN more times and averaged: one ask decides it by chance. */
+export const NEAR = 0.1;
+const AGAIN = 2;
+
+/**
+ * Noul values per window from `ask`; when any window's value is within NEAR
+ * of `threshold`, every value is the mean of AGAIN + 1 asks, and `line` says
+ * what was asked again.
+ */
+export async function steady(ask: () => Promise<number[][]>, threshold: number, names: string[]): Promise<{ nouls: number[][]; line?: string }> {
+  const first = await ask();
+  const near = first.flatMap((n, i) => (Math.abs(Math.max(...n) - threshold) < NEAR ? [i] : []));
+  if (near.length === 0) return { nouls: first };
+  const snap = snapshot();
+  const all = [first, ...(await Promise.all(Array.from({ length: AGAIN }, ask)))];
+  const nouls = first.map((n, i) => n.map((_, j) => all.reduce((sum, a) => sum + a[i]![j]!, 0) / all.length));
+  const shown = near.map((i) => `${names[i]} ${all.map((a) => Math.max(...a[i]!).toFixed(2)).join(" ")} → ${Math.max(...nouls[i]!).toFixed(2)}`);
+  return { nouls, line: `reask  ${shown.join(", ")}  ${split(snap)}` };
+}
