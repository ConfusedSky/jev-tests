+
+describe("steady", () => {
+  const asker = (values: number[][][]) => {
+    let n = 0;
+    return { ask: async () => values[n++]!, asked: () => n };
+  };
+
+  test("a value clear of the threshold is asked once", async () => {
+    const { ask, asked } = asker([[[0.9], [0.1]]]);
+    expect(await steady(ask, 0.7, ["p.1", "p.2"])).toEqual({ nouls: [[0.9], [0.1]] });
+    expect(asked()).toBe(1);
+  });
+
+  test("a value near the threshold is asked twice more, and every value is the mean", async () => {
+    const { ask, asked } = asker([
+      [[0.66, 0.2], [0.1, 0]],
+      [[0.75, 0.2], [0.4, 0]],
+      [[0.78, 0.2], [0.1, 0]],
+    ]);
+    const { nouls, line } = await steady(ask, 0.7, ["p.344", "p.345"]);
+    expect(asked()).toBe(3);
+    expect(nouls.map((n) => n.map((v) => +v.toFixed(3)))).toEqual([[0.73, 0.2], [0.2, 0]]);
+    expect(line).toStartWith("reask  p.344 0.66 0.75 0.78 → 0.73  ");
+  });
+});
