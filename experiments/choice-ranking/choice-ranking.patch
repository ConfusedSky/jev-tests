+/** Options a choice holds beside "none of these". */
+const CHOICE_MAX = 254;
+const NONE = "none of these";
+
+/** One choice among `items`, or a choice per chunk and a final among the chunks' picks; the picks best first. */
+async function pickRound<T extends { label: string }>(client: TypeSafeClient, question: string, noun: string, items: T[]): Promise<{ item: T; p: number }[]> {
+  const ask = async (of: T[]) => {
+    // A label is the option's key; two alike would merge.
+    const keyed = new Map<string, T>();
+    for (const it of of) {
+      let k = it.label;
+      for (let n = 2; keyed.has(k) || k === NONE; n++) k = `${it.label} #${n}`;
+      keyed.set(k, it);
+    }
+    const res = await client.systemOne({
+      state: { question },
+      questions: { pick: choice(`Which of these ${noun}s answers \`question\`?`, { ...Object.fromEntries([...keyed.keys()].map((k) => [k, null])), [NONE]: null }) },
+    });
+    const probs = (res.answers.pick as { probabilities: Record<string, number> }).probabilities;
+    // jev rounds to 0.01, so every option under half a percent is a zero
+    // and has no order; only the ones above it are picks.
+    return [...keyed].map(([k, item]) => ({ item, p: probs[k] ?? 0 })).filter((x) => x.p > 0).sort((a, b) => b.p - a.p);
+  };
+  if (items.length <= CHOICE_MAX) return ask(items);
+  const chunks: T[][] = [];
+  for (let i = 0; i < items.length; i += CHOICE_MAX) chunks.push(items.slice(i, i + CHOICE_MAX));
+  const heats = (await Promise.all(chunks.map(ask))).flat();
+  if (heats.length <= 1) return heats;
+  const final = await ask(heats.slice(0, CHOICE_MAX).map((h) => h.item));
+  // A heat's pick the final gave nothing still beats what no heat picked.
+  const inFinal = new Set(final.map((f) => f.item));
+  return [...final, ...heats.filter((h) => !inFinal.has(h.item)).map((h) => ({ ...h, p: 0 }))];
+}
+
+/**
+ * `rank` as choices instead of a score per item: every item an option of
+ * one "which of these answers" choice, ranked by its probability. The
+ * picks are taken out and the rest asked again until `want` items of
+ * `wantList` are ranked or a round picks nothing; what no round picked
+ * follows, in list order. A pick scores 1 to 3 by its place, so the title
+ * floor keeps meaning "picked at all".
+ */
+export async function rankChoice(
+  client: TypeSafeClient,
+  question: string,
+  lists: List[],
+  { want = 12, wantList = "candidates", rounds = 4 } = {},
+): Promise<Ranked[]> {
+  type Item = { label: string; list: List; index: number };
+  let left: Item[] = lists.flatMap((l) => l.items.map((item, index) => ({ label: item.label, list: l, index })));
+  const noun = lists.filter((l) => l.items.length).map((l) => l.noun).join(" or ") || "item";
+  const picked: { item: Item; p: number }[] = [];
+  await timed("api", async () => {
+    for (let r = 0; r < rounds && left.length && picked.filter((x) => x.item.list.key === wantList).length < want; r++) {
+      const round = await pickRound(client, question, noun, left);
+      if (!round.length) break;
+      picked.push(...round);
+      const out = new Set(round.map((x) => x.item));
+      left = left.filter((it) => !out.has(it));
+    }
+  });
+  const n = picked.length;
+  return [
+    ...picked.map(({ item, p }, i) => ({ name: item.label, list: item.list.key, index: item.index, score: 3 - (2 * i) / Math.max(1, n), confidence: p, reason: `picked ${i + 1} of ${n} (p=${p.toFixed(2)})` })),
+    ...left.map((item) => ({ name: item.label, list: item.list.key, index: item.index, score: 0, confidence: 0, reason: "never picked" })),
+  ];
+}
