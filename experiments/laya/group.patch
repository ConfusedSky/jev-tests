+
+/**
+ * `client` asking at most `group` questions per call, the state sent again
+ * with each group and the answers merged; 0 asks them all at once.
+ */
+export function grouped(client: TypeSafeClient, group: number): TypeSafeClient {
+  if (!(group > 0)) return client;
+  const one = client.systemOne.bind(client);
+  client.systemOne = (async (request: Parameters<typeof one>[0]) => {
+    const entries = Object.entries(request.questions);
+    if (entries.length <= group) return one(request);
+    const parts = [];
+    for (let i = 0; i < entries.length; i += group) parts.push(entries.slice(i, i + group));
+    const res = await Promise.all(parts.map((p) => one({ ...request, questions: Object.fromEntries(p) } as typeof request)));
+    return {
+      ...res[0]!,
+      answers: Object.assign({}, ...res.map((r) => r.answers)),
+      usage: {
+        input_tokens: res.reduce((n, r) => n + (r.usage?.input_tokens ?? 0), 0),
+        output_tokens: res.reduce((n, r) => n + (r.usage?.output_tokens ?? 0), 0),
+      },
+    };
+  }) as typeof client.systemOne;
+  return client;
 }
 
 /** `client` with every call's tokens added to `tokens`, so each step can say what it spent. */
