+/** Runs of text ending at a sentence end or a blank line, trailing space included. */
+const SENTENCES = /[\s\S]*?(?:[.!?]+["')\]]*(?=\s|$)|\n[ \t]*\n|$)\s*/g;
+
+/**
+ * `text` cut into pieces of at most `chars`, at sentence or paragraph ends;
+ * only a sentence longer than a piece is cut inside, at a space.
+ */
+export function pieces(text: string, chars: number): string[] {
+  if (!(chars > 0) || text.length <= chars) return [text];
+  const out: string[] = [];
+  let buf = "";
+  for (let run of text.match(SENTENCES)!) {
+    if (buf && buf.length + run.length > chars) {
+      out.push(buf);
+      buf = "";
+    }
+    while (run.length > chars) {
+      const at = run.lastIndexOf(" ", chars);
+      const cut = at > 0 ? at : chars;
+      out.push(run.slice(0, cut));
+      run = run.slice(cut);
+    }
+    buf += run;
+  }
+  if (buf) out.push(buf);
+  return out;
+}
